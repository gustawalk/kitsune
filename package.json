{
  "name": "kitsune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run types:check && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format": "prettier --write src tests scripts docs README.md package.json index.html && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src tests scripts docs README.md package.json index.html && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:rust": "bun scripts/test-rust.ts",
    "types:generate": "bun scripts/generate-types.ts",
    "types:check": "bun scripts/generate-types.ts --check",
    "test:contracts": "bun scripts/check-contracts.ts",
    "engines:check": "bun scripts/engine-fixtures.ts check",
    "engines:up": "bun scripts/engine-fixtures.ts up",
    "engines:test": "bun scripts/engine-fixtures.ts test",
    "engines:down": "bun scripts/engine-fixtures.ts down"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "4.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "2.11.5",
    "prettier": "3.9.9",
    "@types/bun": "1.4.2"
  }
}

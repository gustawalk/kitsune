{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitsune",
  "version": "0.1.1",
  "identifier": "dev.kitsune.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kitsune",
        "dragDropEnabled": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "walk",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpq5"
        ]
      }
    },
    "shortDescription": "Understand your data.",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "Kitsune",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGREVCRjNCNzYyOUJGRjkKUldUNXZ5bDJPNy9lSHlGblFyMUtsVTZDeXF5QnhxcFFXK3NjTjh5bWRjRk5jWW96N3NWNlNlZjkK",
      "endpoints": [
        "https://github.com/gustawalk/kitsune/releases/latest/download/updater.json"
      ]
    }
  }
}
